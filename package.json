{
  "name": "workout-page",
  "description": "Personal workout dashboard — strength training tracker with analytics",
  "version": "1.0.0",
  "license": "MIT",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@8.9.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{css,module.css,json,ts,tsx}\" \"*.{json,ts}\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.15.2",
    "vite": "^7.1.2",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.31.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.13",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.61.1"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "^24.2.1"
    }
  }
}
